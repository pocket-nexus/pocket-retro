{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "retro": ["../sdk/retro.ts"],
      "@pocketjs/framework/solid/std": ["../pocketjs/framework/src/std-microts.ts"]
    }
  },
  "include": ["**/*.ts", "../sdk/**/*.ts"]
}
